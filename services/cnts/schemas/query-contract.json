{
  "contract_version": 1,
  "endpoint": "POST /api/v1/engine/query",
  "agent_channel": "http",
  "request_scope": "one immutable runtime profile per request",
  "dataset_execution": "one pinned generation per logical fact dataset",
  "orchestration": {
    "multi_dataset": "engine semantic layer",
    "yoy_mom": "engine semantic layer",
    "merge": "engine semantic layer",
    "single_tree_filter_group_aggregate": "storage adapter"
  },
  "no_match": "empty result, never numeric zero",
  "fallback": "forbidden",
