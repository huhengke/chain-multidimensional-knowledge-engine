        "freight_pay_amount": "实付运费",
        "freight_coupon_amount": "运费优惠券金额",
        "freight_points_amount": "运费积分金额",
        "real_amount": "实收金额",
        "convert_amount": "转换金额"
      },
      "order_key": "shopping_order_id"
    },
    "oil_sales_plan": {
      "label": "油品销售计划",
      "aliases": ["站点销售计划", "销售计划"],
      "kind": "fact",
      "scope": {"role": "plan", "business_domain": "oil_plan"},
      "time_granularity": "month",
