      "kind": "fact",
      "scope": {
        "role": "actual",
        "business_domain": "non_oil",
        "preferred_for": ["day", "month"],
        "priority": 100
      },
      "time_granularity": "day",
      "metrics": {
        "total_amount": "订单总额",
