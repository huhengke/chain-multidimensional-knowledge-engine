{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "topology-node.schema.json",
  "title": "M1 拓扑契约（RingRef / TopologyNode / OccurrenceRef）",
  "$ref": "#/$defs/TopologyNode",
  "$defs": {
    "RingRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tree_id": { "type": "string", "minLength": 1 },
        "day_key": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "ring_index": { "type": "integer", "minimum": 0 }
      },
      "required": ["tree_id", "day_key", "ring_index"]
    },
    "TopologyNode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node_id": { "type": "string", "minLength": 1 },
        "tree_id": { "type": "string", "minLength": 1 },
        "day_key": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "ring_index": { "type": "integer", "minimum": 0 },
        "layer": { "enum": ["inner", "middle", "outer"] },
        "generation": { "type": "integer", "minimum": 1 },
        "payload_ref": { "type": "string", "pattern": "^store://" },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "occurrence_refs": { "type": "array", "items": { "type": "string" } },
        "children": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["node_id", "tree_id", "day_key", "ring_index", "layer", "payload_ref"]
    },
    "OccurrenceRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "occurrence_id": { "type": "string", "minLength": 1 },
        "tree_id": { "type": "string", "minLength": 1 },
        "day_key": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "node_id": { "type": "string", "minLength": 1 },
        "evidence_ref": { "type": "string", "minLength": 1 }
      },
      "required": ["occurrence_id", "tree_id", "day_key", "node_id", "evidence_ref"]
    }
  }
}