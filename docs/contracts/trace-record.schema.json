{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trace-record.schema.json",
  "title": "M1 向量留痕层与记忆星团契约（TraceRecord / StarCluster）",
  "$ref": "#/$defs/TraceRecord",
  "description": "aggregate_key 严禁包含日期；日期只能经 OccurrenceRef 表达。指标一律用定点数字符串。",
  "$defs": {
    "TraceRecord": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trace_id": { "type": "string", "minLength": 1 },
        "aggregate_key": {
          "type": "string",
          "pattern": "://",
          "not": { "pattern": "\\d{4}-\\d{2}-\\d{2}|\\d{4}/\\d{2}/\\d{2}|(?<!\\d)\\d{8}(?!\\d)" }
        },
        "vector": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "source_ref": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "minLength": 1 }
      },
      "required": ["trace_id", "aggregate_key", "vector", "source_ref", "created_at"]
    },
    "StarCluster": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cluster_id": { "type": "string", "minLength": 1 },
        "tree_id": { "type": "string", "minLength": 1 },
        "prototype_vector": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "tolerance": { "type": "string" },
        "occurrence_count": { "type": "integer", "minimum": 0 },
        "centroid": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "dispersion": { "type": "string" },
        "sub_clusters": { "type": "array", "items": { "type": "string" } },
        "algo_version": { "type": "string", "minLength": 1 },
        "rule_version": { "type": "string", "minLength": 1 },
        "growth_events": { "type": "array", "items": { "type": "string" } },
        "member_trace_ids": { "type": "array", "items": { "type": "string" } }
      },
      "required": [
        "cluster_id",
        "tree_id",
        "prototype_vector",
        "tolerance",
        "occurrence_count",
        "centroid",
        "dispersion",
        "algo_version",
        "rule_version"
      ]
    }
  }
}